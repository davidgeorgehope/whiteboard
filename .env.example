# Cursor API key from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional: force a specific model for beautification (must be vision-capable).
# Leave empty to auto-pick from your available models.
CURSOR_MODEL=

# Optional: mirror the paper onto a FigJam board after each beautify pass.
# FIGMA_BOARD_URL is the FigJam board link (figma.com/board/...); leave empty
# to disable. Auth is OAuth, not a token: add the server to ~/.cursor/mcp.json
#   { "mcpServers": { "figma": { "url": "https://mcp.figma.com/mcp" } } }
# then run `cursor-agent mcp login figma` from this repo and approve in the
# browser (run it twice if it asks to re-run to complete authentication).
FIGMA_BOARD_URL=
